# =====================================================================
# POC agéntica — variables de entorno de ejemplo
# Copia a .env y ajusta. NUNCA subas .env real al repositorio.
# Todos los endpoints de inferencia son LOCALES (vLLM en Docker Compose).
# =====================================================================

# --- Entorno y logging ---
APP_ENV=development
LOG_LEVEL=INFO
# json | text  (json para producción, text para desarrollo)
LOG_FORMAT=text
# Si true, la pregunta del usuario solo se registra truncada + hash en los logs
PRIVACY_LOG_QUESTIONS=false

# --- LLM local (vLLM servicio `llm`) ---
# Dentro de Compose usa http://llm:8000/v1; en local, http://127.0.0.1:8000/v1
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Debe coincidir con --served-model-name del servidor vLLM
LLM_MODEL=local-llm
# Clave ficticia local: vLLM no exige auth por defecto, el cliente OpenAI sí
LLM_API_KEY=local-vllm-key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
# Desactiva el modo thinking de Qwen3 (menos latencia y tokens en 4B)
LLM_ENABLE_THINKING=false
# Seguridad: si es false, el arranque falla si LLM_BASE_URL/EMBEDDINGS_BASE_URL
# apunta a un host que no es local (sin fallback remoto posible)
ALLOW_REMOTE_INFERENCE=false

# --- Embeddings locales (vLLM servicio `embeddings`) ---
# Dentro de Compose usa http://embeddings:8001/v1; en local, http://127.0.0.1:8001/v1
EMBEDDINGS_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDINGS_MODEL=local-embeddings
EMBEDDINGS_API_KEY=local-vllm-key
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_QUERY_PREFIX=query:
EMBEDDINGS_PASSAGE_PREFIX=passage:

# --- Modelos (solo informativo para la descarga inicial; la inferencia es local) ---
LLM_HF_REPO=Qwen/Qwen3-4B-AWQ
EMBEDDINGS_HF_REPO=intfloat/multilingual-e5-small
VLLM_IMAGE=vllm/vllm-openai:v0.31.0

# --- ERP (SQLite Northwind de demostración, solo lectura en la aplicación) ---
ERP_DATABASE_URL=sqlite:///data/erp/northwind.db
ERP_MAX_ROWS=500
ERP_QUERY_TIMEOUT_SECONDS=10

# --- Sistema de producción simulado (servicio independiente) ---
PRODUCTION_API_URL=http://127.0.0.1:8090
PRODUCTION_TIMEOUT_SECONDS=10
PRODUCTION_MAX_RETRIES=1

# --- RAG ---
VECTOR_STORE_PATH=data/vector_store
DOCUMENTS_DIR=data/documents
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=200
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# --- Persistencia de la aplicación (memoria conversacional y trazas) ---
APP_DB_PATH=data/app.db
MEMORY_MAX_TURNS=5
MEMORY_RETENTION_MESSAGES=50

# --- API ---
# Comma-separated; CORS de demostración para la UI Chainlit
CORS_ORIGINS=http://127.0.0.1:8585,http://localhost:8585

# --- UI Chainlit (solo la necesita el proceso de UI) ---
BACKEND_URL=http://127.0.0.1:8080
